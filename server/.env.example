# Entera.ai Backend Production Environment Variables Template
PORT=5000
NODE_ENV=production

# PostgreSQL Database Configuration
# Either provide DATABASE_URL or individual POSTGRES_* parameters
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<STRONG_DATABASE_PASSWORD>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=entera
DATABASE_SSL=false

# Authentication & Session Secrets
JWT_SECRET=<GENERATE_A_RANDOM_64_CHAR_SECRET>
SESSION_SECRET=<GENERATE_A_RANDOM_64_CHAR_SECRET>

# Security & CORS
# Comma-separated list of allowed frontend origins (No wildcards in production)
CORS_ORIGIN=https://app.entera.ai,http://localhost:5173,http://localhost:4173
FRONTEND_URL=https://app.entera.ai

# Initial System Administrator (Optional initial seed on blank database)
INITIAL_ADMIN_EMAIL=admin@gmail.com
INITIAL_ADMIN_PASSWORD=<CHANGE_ME_ON_DEPLOYMENT>
